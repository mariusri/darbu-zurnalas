+  // ---------- Paieška ----------
+  const norm = t => String(t || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
+  function searchResults() {
+    const q = norm($("#q-text").value.trim()), from = $("#q-from").value, to = $("#q-to").value;
+    const words = q.split(/\s+/).filter(Boolean);
+    return state.entries.filter(e => {
+      if (from && e.date < from) return false;
+      if (to && e.date > to) return false;
+      if (!words.length) return true;
+      const hay = norm([e.object, e.work, e.author, ...(e.workers || []).map(w => w.name)].join(" "));
+      return words.every(w => hay.includes(w));
+    }).sort((a, b) => b.date.localeCompare(a.date) || (b.createdAt || 0) - (a.createdAt || 0));
+  }
+  function setRange(kind) {
+    const now = new Date(); let a = "", b = "";
+    if (kind === "week") { a = weekStart(ymd(now)); b = addDays(a, 6); }
+    else if (kind === "month") { a = ymd(new Date(now.getFullYear(), now.getMonth(), 1)); b = ymd(new Date(now.getFullYear(), now.getMonth() + 1, 0)); }
+    else if (kind === "prev") { a = ymd(new Date(now.getFullYear(), now.getMonth() - 1, 1)); b = ymd(new Date(now.getFullYear(), now.getMonth(), 0)); }
+    $("#q-from").value = a; $("#q-to").value = b;
+    renderSearch();
+  }
+  function renderSearch() {
+    const objs = [...new Set(state.entries.map(e => (e.object || "").trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, "lt"));
+    $("#obj-list").innerHTML = objs.map(o => `<option value="${esc(o)}"></option>`).join("");
+    const body = $("#search-body");
+    if (!state.loaded) { body.innerHTML = `<p class="status">Kraunami įrašai…</p>`; return; }
+    const list = searchResults();
+    const any = $("#q-text").value.trim() || $("#q-from").value || $("#q-to").value;
+    if (!list.length) {
+      body.innerHTML = `<div class="empty"><strong>Nieko nerasta</strong><span>${any ? "Pabandykite trumpesnį žodį arba platesnį laikotarpį." : "Įrašų dar nėra."}</span></div>`;
+      return;
